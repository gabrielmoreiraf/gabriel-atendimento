# Copie para .env (que nunca é commitado) e preencha.
# cp .env.example .env

# Chave da API da Anthropic (Claude). Sem ela o FIO usa o leitor por regras.
ANTHROPIC_API_KEY=

# 1 liga o leitor com Claude (com volta automática para o leitor por regras se a API falhar).
# 0 mantém a demo determinística.
ATENDIMENTO_LLM=0

# Token do app do Slack (opcional). Sem ele o canal do time fica na própria interface.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
