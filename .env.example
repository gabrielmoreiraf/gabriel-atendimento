# Copie para .env (que nunca é commitado) e preencha.
# cp .env.example .env

# Chave da API da Anthropic (Claude). Sem ela o FIO usa o leitor por regras.
ANTHROPIC_API_KEY=

# 1 liga o leitor com Claude (com volta automática para o leitor por regras se a API falhar).
# 0 mantém a demo determinística.
ATENDIMENTO_LLM=0

# Canal do time no Slack (opcional). Sem ele o canal do time fica só na própria interface.
# 1 liga o espelho no Slack (aprovação e decisão de suspeita por botão).
ATENDIMENTO_SLACK=0
# Bot User OAuth Token (começa com xoxb-)
SLACK_BOT_TOKEN=
# App-Level Token com o escopo connections:write (começa com xapp-), para o Socket Mode
SLACK_APP_TOKEN=
# ID do canal do time (ex.: C0123456789), em Detalhes do canal
SLACK_CANAL_ID=
# Quem pode aprovar pelo Slack: member ID do Slack -> colaborador_id da equipe, separados por vírgula
# ex.: U0AAA111:supervisor_01,U0BBB222:supervisor_02
SLACK_SUPERVISORES=
# Modo do Slack: socket (local, WebSocket com o SLACK_APP_TOKEN) ou http (Vercel, endpoint
# /api/slack/eventos assinado). Vazio: http quando a variável VERCEL existe, senão socket.
ATENDIMENTO_SLACK_MODO=
# Signing Secret do app (Basic Information > App Credentials), obrigatório no modo http
SLACK_SIGNING_SECRET=
