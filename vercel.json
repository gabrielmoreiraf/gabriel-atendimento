{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "api": {
      "root": ".",
      "entrypoint": "servidor_vercel.py",
      "functions": {
        "servidor_vercel.py": {
          "maxDuration": 300,
          "excludeFiles": "{docs/**,.env*,var/**,evidencias/**,.scratch/**,graphify-out/**,ingestao/**,web/**,tests/**,e2e/**,apresentacao/**,prototipo/**,entrega/**,.claude/**,.venv/**,.vercel/**,*.md,decisoes/**,tasks/**,**/__pycache__/**,.*cache/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
