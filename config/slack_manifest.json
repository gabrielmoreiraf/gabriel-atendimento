{
  "display_information": {
    "name": "FIO",
    "description": "O colega de atendimento (Gocase / GoBeauté)",
    "background_color": "#0b3d91"
  },
  "features": {
    "bot_user": {
      "display_name": "FIO",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "chat:write.public",
        "app_mentions:read",
        "channels:history",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_mention"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
